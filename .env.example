# Copie para .env e ajuste. O .env fica fora do git.

# Porta publicada no servidor
PAINEL_PORTA=5500

# Administrador criado no primeiro início (troca de senha obrigatória no primeiro acesso).
# Sem ADMIN_PASS, uma senha aleatória é mostrada no log: docker compose logs painel
ADMIN_USER=admin
ADMIN_PASS=

# Chave das sessões de login. Em branco: gerada e guardada no volume.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Chave que criptografa a configuração do banco (config_banco.enc). Em branco:
# gerada e guardada no volume. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAINEL_CHAVE_CONFIG=

# PostgreSQL (opcional: também pode ser informado na página Configuração do Banco,
# que tem prioridade sobre estas variáveis). PostgreSQL na própria máquina: DB_HOST=host.docker.internal
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_SCHEMA=public
DB_SCHEMA_PAINEL=painel
